{
  "name": "viajes-cristian-torres-pfy2202",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SPA de agencia de viajes con REST + GraphQL mock (MSW) para Desarrollo Frontend II - PFY2202",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:pages": "vite preview --mode pages",
