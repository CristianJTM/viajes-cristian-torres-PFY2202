    "postbuild:pages": "node scripts/postbuild.mjs",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d dist",
    "evidencias": "npm run build:pages && node scripts/capturar-evidencias.mjs"
  },
  "dependencies": {
    "@apollo/client": "^3.11.8",
    "graphql": "^16.9.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.1.1",
    "msw": "^2.4.9",
    "playwright": "^1.65.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
